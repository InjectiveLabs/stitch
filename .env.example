# stitch environment variables
#
# stitch expands ${VAR_NAME} and $VAR_NAME tokens in the YAML config
# at load time, so secrets and per-environment URLs live here instead
# of in the file checked into git.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your real upstream URLs
#   export $(grep -v '^#' .env | xargs)
#   stitch start --config config.yaml
#
# Or with docker compose: env_file: .env

# ---------------------------------------------------------------------
# Upstream URLs — referenced from config.yaml via ${VAR_NAME}
# ---------------------------------------------------------------------

# Primary archive node
ARCHIVE_RPC_URL=http://archive.example.com:26657
ARCHIVE_GRPC_URL=archive.example.com:9900
ARCHIVE_API_URL=http://archive.example.com:1317
ARCHIVE_ETH_RPC_URL=http://archive.example.com:8545
ARCHIVE_ETH_WS_URL=ws://archive.example.com:8546
ARCHIVE_CHAINSTREAM_URL=archive.example.com:9999

# Secondary / hot-tier node (latest blocks only)
HOT_RPC_URL=http://hot.example.com:26657
HOT_GRPC_URL=hot.example.com:9900
HOT_API_URL=http://hot.example.com:1317
HOT_ETH_RPC_URL=http://hot.example.com:8545
HOT_ETH_WS_URL=ws://hot.example.com:8546

# ---------------------------------------------------------------------
# Optional listener overrides
# ---------------------------------------------------------------------

# Bind addresses (defaults shown)
# STITCH_RPC_ADDR=0.0.0.0:5001
# STITCH_GRPC_ADDR=0.0.0.0:5002
# STITCH_API_ADDR=0.0.0.0:5003
# STITCH_ETH_RPC_ADDR=0.0.0.0:5005
# STITCH_ETH_WS_ADDR=0.0.0.0:5006
# STITCH_CHAINSTREAM_ADDR=0.0.0.0:5007
# STITCH_INJ_WS_ADDR=0.0.0.0:5008
# STITCH_ADMIN_ADDR=127.0.0.1:9091

# Log level: debug | info | warn | error
# STITCH_LOG_LEVEL=info

# Log format: json | text
# STITCH_LOG_FORMAT=json
